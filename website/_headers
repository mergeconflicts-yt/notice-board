# Cloudflare Pages headers.
# The marketing site and the invite-link fallback share this origin.

# Static assets are content-addressed by name, so cache them hard; HTML
# (no rule here) keeps Cloudflare's default revalidation.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Universal-link association files (added once the Apple IDs exist).
/.well-known/*
  Content-Type: application/json

# Invite fallback pages: keep them out of search, never noindex the site.
/j/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/*
  X-Content-Type-Options: nosniff
