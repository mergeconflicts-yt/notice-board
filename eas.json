{
  "$schema": "https://cdn.jsdelivr.net/npm/eas-cli@latest/dist/eas.schema.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "preview-simulator": {
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6818976344"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
