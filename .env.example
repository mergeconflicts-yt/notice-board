# Public client config (safe to ship in the bundle).
# Local dev: start the stack (`supabase start`) and copy the values from
# `supabase status` into `.env` (see docs/infrastructure.md).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Universal-link origin for invites (docs/plan.md §11). Optional locally.
EXPO_PUBLIC_INVITE_BASE_URL=

# Cloudflare Turnstile site key for anonymous sign-in captcha (production).
# Leave empty locally — captcha is off and the app signs in without it.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
